# Firebase web config for studenttracker-ab108.
#
# Committed on purpose. A Firebase web API key is not a credential — it
# identifies the project and ships in the JS bundle of every Firebase web app.
# firestore.rules is what actually protects the data.
#
# Vite inlines these at build time, so the GitHub Actions build reads this file
# straight from the repo. Nothing to configure in GitHub settings.
VITE_FB_API_KEY=AIzaSyA7wd0yQhdkwt7Ud0ACPsDhymtrwBnbcEI
VITE_FB_AUTH_DOMAIN=studenttracker-ab108.firebaseapp.com
VITE_FB_PROJECT_ID=studenttracker-ab108
VITE_FB_STORAGE_BUCKET=studenttracker-ab108.firebasestorage.app
VITE_FB_SENDER_ID=1039856822197
VITE_FB_APP_ID=1:1039856822197:web:df8667b22d0cd556d7dbfc
