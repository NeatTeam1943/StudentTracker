rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMentor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/mentors/$(request.auth.uid));
    }

    // Everyone reads. Guests see the same profiles mentors do, with no sign-in.
    match /people/{id} {
      allow read: if true;
      allow write: if isMentor();
    }

    // One sub-team: its categories, its items, its rank requirements.
    match /teams/{id} {
      allow read: if true;
      allow write: if isMentor();
    }

    match /meta/{id} {
      allow read: if true;
      allow write: if isMentor();
    }

    // The log is append-only. Nobody edits or deletes history, mentors included.
    match /events/{id} {
      allow read: if true;
      allow create: if isMentor();
      allow update, delete: if false;
    }

    // Anyone signed in can ask for mentor access, and only for themselves —
    // request.auth.uid == uid stops one person requesting on another's behalf.
    match /mentorRequests/{uid} {
      allow read: if isMentor() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if isMentor() || (request.auth != null && request.auth.uid == uid);
      allow update: if false;
    }

    // Existing mentors approve new ones from the מנטורים page.
    // Readable by all so the app knows whether to show edit controls.
    match /mentors/{uid} {
      allow read: if true;
      allow create, delete: if isMentor();
      allow update: if false;
    }
  }
}
