# Firebase web config. Copy to .env.local for development.
# These are not secrets — Firestore rules are what protect the data.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
